# ==============================================================================
# OpenStack Image Project — .gitignore
# ==============================================================================

# Temporary build files (NEVER commit)
build/tmp/
image/tmp/
scripts/temp/

# Secrets (CRITICAL — NEVER commit)
.env
.env.local
.env.*.local
*.private
*.key
*.pem
credentials.txt
secrets.txt

# Python runtime
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
# build/tmp/ already specified above
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-log.txt
pip-delete-this-directory.txt

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS
.DS_Store
*.log
.directory

# Test & Coverage
.pytest_cache/
.coverage
htmlcov/

# Task management (optional)
.todo
TODO.txt

# SSH & Runtime
*.conf.bak
*.conf.orig

# ==============================================================================
# WHITELIST — These files ARE tracked
# ==============================================================================
# ! docs/
# ! scripts/
# ! build/
# ! Makefile
# ! CONTRIBUTING.md
# ! .gitignore (this file)
