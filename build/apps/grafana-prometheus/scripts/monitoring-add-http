#!/usr/bin/env bash
set -euo pipefail

FILE=/opt/monitoring/prometheus/targets/http.yml

if [ "$(id -u)" -ne 0 ]; then
  echo "Run with sudo: sudo monitoring-add-http <url> <name>" >&2
  exit 1
fi

if [ "$#" -ne 2 ]; then
  echo "Usage: sudo monitoring-add-http https://example.com website-prod" >&2
  exit 1
fi

target="$1"
name="$2"

case "$target" in
  http://*|https://*) ;;
  *) echo "Target must start with http:// or https://" >&2; exit 1 ;;
esac

cat >> "$FILE" << EOF
- targets:
    - $target
  labels:
    name: $name
    role: http
EOF

monitoring-reload
echo "Added HTTP target: $name -> $target"
