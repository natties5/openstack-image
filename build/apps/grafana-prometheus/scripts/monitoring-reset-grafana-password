#!/usr/bin/env bash
set -euo pipefail

APP_DIR=/opt/monitoring
ENV_FILE="$APP_DIR/.env"
INFO_FILE=/root/README-grafana-prometheus-image.txt

if [ "$(id -u)" -ne 0 ]; then
  echo "Run with sudo: sudo monitoring-reset-grafana-password" >&2
  exit 1
fi

random_secret() {
  openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
}

get_primary_ip() {
  hostname -I 2>/dev/null | awk '{print $1}'
}

new_password="$(random_secret)"
vm_ip="$(get_primary_ip)"

docker compose -f "$APP_DIR/docker-compose.yml" --env-file "$ENV_FILE" up -d grafana
sleep 5
docker exec grafana grafana cli admin reset-admin-password "$new_password"

if grep -q '^GRAFANA_ADMIN_PASSWORD=' "$ENV_FILE"; then
  sed -i "s/^GRAFANA_ADMIN_PASSWORD=.*/GRAFANA_ADMIN_PASSWORD=$new_password/" "$ENV_FILE"
else
  echo "GRAFANA_ADMIN_PASSWORD=$new_password" >> "$ENV_FILE"
fi
chmod 600 "$ENV_FILE"

cat > "$INFO_FILE" << EOF
Grafana+Prometheus Monitoring Image
====================================

Grafana URL:
  http://${vm_ip:-<VM-IP>}/

Login:
  Username: admin
  Password: $new_password

Quick commands:
  monitoring-info
  monitoring-status
  monitoring-list-targets
  monitoring-add-http https://example.com website
  monitoring-add-node 10.0.0.12:9100 web-01
  monitoring-add-tcp 10.0.0.20:5432 postgres-01
  monitoring-add-ping 10.0.0.30 router-01
  monitoring-reset-grafana-password

Password was reset at: $(date -Is)
EOF
chmod 600 "$INFO_FILE"

echo "Grafana admin password reset. Read it with: sudo monitoring-info"
