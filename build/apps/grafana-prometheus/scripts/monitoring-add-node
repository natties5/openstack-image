#!/usr/bin/env bash
set -euo pipefail

FILE=/opt/monitoring/prometheus/targets/nodes.yml

if [ "$(id -u)" -ne 0 ]; then
  echo "Run with sudo: sudo monitoring-add-node <host:9100> <name>" >&2
  exit 1
fi

if [ "$#" -ne 2 ]; then
  echo "Usage: sudo monitoring-add-node 10.0.0.12:9100 web-01" >&2
  exit 1
fi

target="$1"
name="$2"

cat >> "$FILE" << EOF
- targets:
    - $target
  labels:
    name: $name
    role: node
EOF

monitoring-reload
echo "Added node target: $name -> $target"
